model Exam {
  id           String    @id @default(uuid())
  sectionId    String
  title        String
  type         ExamType
  examDate     DateTime
  totalMarks   Float
  passingMarks Float
  weight       Float
  isActive     Boolean   @default(true)
  deletedAt    DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  section Section  @relation(fields: [sectionId], references: [id])
  results Result[]

  @@index([sectionId])
  @@index([type])
  @@index([examDate])
  @@index([isActive])
  @@index([deletedAt])
  @@map("exams")
}
