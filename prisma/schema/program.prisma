model Program {
  id           String    @id @default(uuid())
  name         String
  code         String    @unique
  description  String?
  departmentId String
  isActive     Boolean   @default(true)
  deletedAt    DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  department Department @relation(fields: [departmentId], references: [id])

  @@index([departmentId])
  @@index([isActive])
  @@index([deletedAt])
  @@map("programs")
}
