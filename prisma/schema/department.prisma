model Department {
  id          String    @id @default(uuid())
  name        String
  code        String    @unique
  description String?
  isActive    Boolean   @default(true)
  deletedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  programs               Program[]
  courses                Course[]
  instructorApplications InstructorApplication[]

  @@index([isActive])
  @@index([deletedAt])
  @@map("departments")
}
